# Sources & build inputs
src/
tests/
miradex-rust/
scripts/
tsconfig.json
*.tsbuildinfo

# Rust / wasm-pack build artifacts (transient — output is staged into wasm/)
target/
pkg/

# Project docs that aren't part of the SDK contract
